# ChuoAI frontend environment variables
#
# NEXT_PUBLIC_API_URL tells the frontend where the backend API lives.
# It is inlined into the client bundle at build time, so it must be set
# wherever the frontend is built:
#
#   - Local development: copy this file to .env and use the local backend
#       NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
#   - Production (Vercel): set the NEXT_PUBLIC_API_URL environment variable
#       in the Vercel project dashboard (not in source control):
#       NEXT_PUBLIC_API_URL=https://chuoai.onrender.com/api
#
# Do NOT put any secrets here. Anything prefixed NEXT_PUBLIC_ is embedded in
# the browser bundle and shipped to users. All API keys, database credentials,
# and JWT secrets belong in backend/.env (server-side only).
NEXT_PUBLIC_API_URL=http://localhost:8000/api